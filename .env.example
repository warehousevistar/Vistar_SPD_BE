# ---- server ----------------------------------------------------------------
NODE_ENV=development
PORT=4100
CORS_ORIGIN=*

# ---- database (the SPD app owns its own PostgreSQL database) ---------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vistar_spd
PGSSL=false
PG_POOL_MAX=10

# ---- auth ------------------------------------------------------------------
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=12h

# ---- uploads ---------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=16

# ---- FR-8 automated hourly report ------------------------------------------
# Off by default: starting the API should not begin mailing the real
# distribution list. Reports are still generated and viewable in-app.
HOURLY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=spd-app@vistarlogitek.com
